# Credenciales de entorno — copiar a .env y completar con valores propios.
# NUNCA subas el archivo .env real al repositorio.

# === Base de datos (MySQL) ===
# La versión en Kimi usa la base de datos en la nube de la plataforma (no exportable).
# Para self-hosting, crea tu propia base MySQL y pega la URL aquí:
DATABASE_URL="mysql://usuario:password@localhost:3306/visibilizar"

# === Kimi OAuth (opcional — solo si usas login con Kimi) ===
# Estas credenciales NO viajan con el código exportado; genera nuevas en tu portal.
APP_ID=""
APP_SECRET=""
VITE_APP_ID=""
VITE_KIMI_AUTH_URL=""
